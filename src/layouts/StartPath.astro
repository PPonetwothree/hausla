---
/**
 * A "Start here" path: a few gentle, numbered steps that point to what already
 * exists on Hausla, plus what's coming. No medical advice lives here.
 */
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import { crisis } from '../lib/site';
import { url } from '../lib/url';

export interface Step {
  title: string;
  body: string; // trusted HTML written by us
  links?: { label: string; href: string }[]; // internal paths
}
interface Props {
  title: string;
  lede: string;
  current: string; // this path's href, to leave it out of "other paths"
  steps: Step[];
  coming?: string[];
}
const { title, lede, current, steps, coming = [] } = Astro.props;

const paths = [
  { label: "I'm caring for someone", href: '/start/caregiver' },
  { label: "I've just been diagnosed", href: '/start/diagnosed' },
  { label: "I'm in treatment", href: '/start/treatment' },
  { label: "I've finished treatment", href: '/start/after' },
  { label: 'I want to learn or research', href: '/start/learn' },
].filter((p) => p.href !== current);
---
<Base title={title} description={lede}>
  <div class="container page">
    <header class="head stack">
      <p class="eyebrow"><a href={url('/start')}>Start here</a></p>
      <h1>{title}</h1>
      <p class="lede">{lede}</p>
    </header>

    <ol class="steps" role="list">
      {steps.map((s, i) => (
        <li class="step reveal">
          <span class="n" aria-hidden="true">{i + 1}</span>
          <div class="content">
            <h2>{s.title}</h2>
            <div class="body" set:html={s.body} />
            {s.links && s.links.length > 0 && (
              <ul class="links" role="list">
                {s.links.map((l) => (
                  <li><a href={url(l.href)}>{l.label} <Icon name="arrow" size={16} /></a></li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>

    <aside class="help reveal" aria-label="Free helplines">
      <p>
        <strong>If it feels like too much,</strong> you can talk to someone now, free:
        {crisis.lines.map((l, i) => <>{i > 0 && ', or '}<a href={`tel:${l.tel}`}><strong>{l.number}</strong></a> ({l.name.split(' (')[0]})</>)}.
      </p>
    </aside>

    {coming.length > 0 && (
      <section class="coming" aria-labelledby="coming-title">
        <h2 id="coming-title">Coming soon on this path</h2>
        <ul>{coming.map((c) => <li>{c}</li>)}</ul>
        <p class="small muted">We publish each piece only when it's checked against official sources.</p>
      </section>
    )}

    <nav class="others" aria-label="Other starting points">
      <h2>Not quite you?</h2>
      <ul role="list">
        {paths.map((p) => <li><a href={url(p.href)}>{p.label}</a></li>)}
      </ul>
    </nav>
  </div>
</Base>

<style>
  .page { padding-block: var(--s8) var(--s6); }
  .head { --stack: var(--s4); max-width: 46rem; margin-bottom: var(--s7); }
  .head .eyebrow a { color: inherit; text-decoration: none; }
  .head .eyebrow a:hover { text-decoration: underline; }

  .steps { list-style: none; padding: 0; max-width: 46rem; display: grid; gap: 0; }
  .step { display: grid; grid-template-columns: 44px 1fr; gap: var(--s4); position: relative; padding-bottom: var(--s6); max-width: none; }
  .step:not(:last-child)::before {
    content: ''; position: absolute; left: 21px; top: 48px; bottom: 4px; width: 2px; background: var(--line);
  }
  .n {
    width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center;
    background: var(--surface-teal); color: var(--primary-hover); font-family: var(--font-head); font-weight: 700;
  }
  .step:first-child .n { background: var(--surface-clay); color: var(--clay-ink); }
  .content { display: grid; gap: var(--s3); padding-top: 6px; }
  .content h2 { font-size: var(--text-xl); }
  .body { display: grid; gap: var(--s3); color: var(--ink-soft); }
  .body :global(ul) { padding-left: 1.2em; display: grid; gap: var(--s1); }
  .body :global(li::marker) { color: var(--primary); }
  .links { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s2); }
  .links a {
    display: inline-flex; align-items: center; gap: var(--s2); min-height: 44px; padding: var(--s2) var(--s4);
    border: 1.5px solid var(--primary); border-radius: var(--radius-pill); text-decoration: none; font-weight: 600; font-size: var(--text-sm);
  }
  .links a:hover { background: var(--surface-sage); }

  .help { max-width: 46rem; padding: var(--s4) var(--s5); border: 1.5px solid var(--clay); border-radius: var(--radius); background: var(--surface); margin-block: var(--s4) var(--s6); }
  .help a { color: var(--clay-ink); }

  .coming { max-width: 46rem; padding: var(--s5); background: var(--surface-blue); border-radius: var(--radius); display: grid; gap: var(--s3); margin-bottom: var(--s6); }
  .coming h2 { font-size: var(--text-lg); }
  .coming ul { padding-left: 1.2em; display: grid; gap: var(--s1); }

  .others h2 { font-size: var(--text-lg); margin-bottom: var(--s3); }
  .others ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s2); }
  .others a {
    display: inline-flex; align-items: center; min-height: 44px; padding: var(--s2) var(--s4);
    border: 1px solid var(--line-strong); border-radius: var(--radius-pill); color: var(--ink-soft); text-decoration: none; font-size: var(--text-sm);
  }
  .others a:hover { border-color: var(--primary); color: var(--primary); }
</style>
