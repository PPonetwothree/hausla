---
import Icon from './Icon.astro';
import { url } from '../lib/url';
interface Props { number: number; title: string; summary: string; minutes: number; href: string }
const { number, title, summary, minutes, href } = Astro.props;
---
<article class="guide card reveal">
  <p class="num" aria-hidden="true">{String(number).padStart(2, '0')}</p>
  <h3><a href={url(href)}>{title}</a></h3>
  <p class="summary">{summary}</p>
  <p class="meta small"><Icon name="book" size={16} /> {minutes} min read</p>
</article>

<style>
  .guide {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s3);
    transition: border-color var(--dur-fast) var(--ease), transform var(--dur) var(--ease);
  }
  .guide:hover { border-color: var(--primary); }
  .num { font-family: var(--font-head); font-weight: 600; color: var(--clay); font-size: var(--text-sm); letter-spacing: 0.08em; }
  h3 { font-size: var(--text-lg); }
  h3 a { color: var(--ink); text-decoration: none; }
  /* Whole card is clickable, but only the title is announced as a link. */
  h3 a::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius); }
  h3 a:focus-visible { outline: none; }
  .guide:has(a:focus-visible) { outline: 3px solid var(--focus); outline-offset: 3px; }
  .summary { color: var(--ink-soft); font-size: var(--text-sm); flex: 1; }
  .meta { display: inline-flex; align-items: center; gap: var(--s2); color: var(--muted); }
</style>
