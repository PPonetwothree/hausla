---
/**
 * <Term id="dharamshala">dharamshala</Term>
 * A word with its meaning: hover (desktop), tap (phone), focus (keyboard),
 * read aloud (screen readers). Only the first use on a page is underlined.
 */
import { getEntry } from 'astro:content';
import { url } from '../lib/url';

interface Props { id: string }
const { id } = Astro.props;
const entry = await getEntry('glossary', id);
if (!entry) throw new Error(`<Term>: no glossary entry with id "${id}" in src/data/glossary.yaml`);
const tipId = `term-${id}-${Math.random().toString(36).slice(2, 8)}`;
---
<span class="term" data-term={id}><button type="button" class="term-word" aria-describedby={tipId} aria-expanded="false" aria-controls={tipId}><slot /></button><span class="term-tip" id={tipId}><span class="term-head"><strong>{entry.data.term}</strong>{entry.data.hindi && <span class="hindi" lang="hi">{entry.data.hindi}</span>}</span><span class="term-meaning">{entry.data.meaning}</span><a class="term-more" href={url(`/glossary#${id}`)} tabindex="-1">In the glossary →</a></span></span>

<style is:global>
  .term { position: relative; display: inline; }
  .term-word {
    all: unset;
    cursor: help;
    color: inherit;
    text-decoration: underline dotted var(--primary);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.22em;
    border-radius: 3px;
    transition: background-color var(--dur-fast) var(--ease);
  }
  .term-word:hover, .term.is-open .term-word { background: var(--surface-teal); }
  .term-word:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
  .term.is-repeat .term-word { text-decoration: none; cursor: text; }

  .term-tip {
    position: absolute;
    left: 0;
    top: calc(100% + 8px);
    z-index: 30;
    width: max-content;
    max-width: min(20rem, calc(100vw - 2rem));
    display: grid;
    gap: var(--s1);
    padding: var(--s3) var(--s4);
    background: var(--ink);
    color: var(--bg);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    line-height: 1.5;
    text-align: left;
    box-shadow: 0 10px 28px -12px rgb(38 51 47 / 0.45);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-3px) translateX(var(--shift, 0px));
    transition: opacity var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease), visibility 0s linear var(--dur-fast);
  }
  .term-head { display: flex; gap: var(--s2); align-items: baseline; }
  .term-head .hindi { opacity: 0.8; line-height: 1.3; }
  .term-more { color: var(--surface-teal); font-weight: 600; }
  .term-more:hover { color: #fff; }

  /* Show on hover (devices that can hover), keyboard focus, or tap. */
  @media (hover: hover) {
    .term:not(.is-repeat):hover .term-tip { visibility: visible; opacity: 1; transform: translateX(var(--shift, 0px)); transition-delay: 0s; }
  }
  .term:focus-within .term-tip,
  .term.is-open .term-tip { visibility: visible; opacity: 1; transform: translateX(var(--shift, 0px)); transition-delay: 0s; }
  .term.is-open .term-more, .term:focus-within .term-more { pointer-events: auto; }
</style>

