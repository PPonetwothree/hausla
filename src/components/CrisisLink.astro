---
/** Always-visible "talk to someone" control. Works without JavaScript. */
import Icon from './Icon.astro';
import { crisis } from '../lib/site';
---
<details class="crisis" data-close-outside>
  <summary>
    <Icon name="phone" size={18} />
    <span class="full">Talk to someone</span><span class="short" aria-hidden="true">Talk</span>
  </summary>
  <div class="panel" role="group" aria-label="Free helplines">
    <p class="intro">If you are struggling or in danger, you don't have to wait. These lines are free.</p>
    <ul>
      {crisis.lines.map((l) => (
        <li>
          <span class="name">{l.name}</span>
          <a class="num" href={`tel:${l.tel}`}>{l.number}</a>
        </li>
      ))}
    </ul>
    <p class="small muted">Numbers last checked {new Date(crisis.lastVerified).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' })}.</p>
  </div>
</details>

<style>
  .crisis { position: relative; }
  summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    min-height: 44px;
    padding: var(--s2) var(--s4);
    border: 1.5px solid var(--clay);
    border-radius: var(--radius-pill);
    color: var(--clay-ink);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease);
    white-space: nowrap;
  }
  summary::-webkit-details-marker { display: none; }
  summary :global(svg) { flex: none; }
  .short { display: none; }
  /* Narrow phones: keep the helpline button, shorten its label (screen readers still hear the full one). */
  @media (max-width: 26rem) {
    summary { padding-inline: var(--s3); }
    .full { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .short { display: inline; }
  }
  summary:hover, .crisis[open] summary { background: var(--surface-clay); }
  .panel {
    position: absolute;
    right: 0;
    top: calc(100% + var(--s2));
    z-index: 50;
    width: min(22rem, calc(100vw - 2 * var(--gutter)));
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--s5);
    box-shadow: 0 12px 32px -16px rgb(38 51 47 / 0.25);
    animation: drop var(--dur) var(--ease);
  }
  .intro { margin-bottom: var(--s4); }
  ul { list-style: none; padding: 0; display: grid; gap: var(--s3); margin-bottom: var(--s4); }
  li { display: flex; justify-content: space-between; align-items: center; gap: var(--s4); }
  .name { font-size: var(--text-sm); color: var(--ink-soft); line-height: 1.35; }
  .num {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.375rem;
    color: var(--clay-ink);
    text-decoration: none;
    padding: var(--s1) var(--s3);
    border-radius: var(--radius-sm);
    background: var(--surface-clay);
  }
  @media (max-width: 40rem) {
    .panel { position: fixed; top: 76px; left: var(--gutter); right: var(--gutter); width: auto; }
  }
  @keyframes drop { from { opacity: 0; transform: translateY(-4px); } }
</style>
