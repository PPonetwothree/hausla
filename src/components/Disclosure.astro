---
/** Expandable section: lets people open detail only when they're ready. */
import Icon from './Icon.astro';
interface Props { title: string; open?: boolean }
const { title, open = false } = Astro.props;
---
<details class="disclosure" open={open}>
  <summary><span>{title}</span><Icon name="chevron" size={20} /></summary>
  <div class="body stack"><slot /></div>
</details>

<style>
  .disclosure { border-bottom: 1px solid var(--line); }
  .disclosure:first-of-type { border-top: 1px solid var(--line); }
  summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s4);
    padding: var(--s4) var(--s1);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: var(--text-lg);
    cursor: pointer;
  }
  summary::-webkit-details-marker { display: none; }
  summary :global(svg) { flex: none; color: var(--muted); transition: transform var(--dur) var(--ease); }
  details[open] summary :global(svg) { transform: rotate(180deg); }
  summary:hover { color: var(--primary); }
  .body { padding: 0 var(--s1) var(--s5); color: var(--ink-soft); }
  details[open] .body { animation: open var(--dur) var(--ease); }
  @keyframes open { from { opacity: 0; transform: translateY(-4px); } }
</style>
