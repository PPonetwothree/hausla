---
import HubPage from '../layouts/HubPage.astro';
import Hub from '../components/Hub.astro';
const guides = [
  { title: 'Understanding Cancer: The Basics', text: 'What cancer is, how it grows, and what words like stage and grade mean.' },
  { title: 'Processing the Diagnosis', text: 'The first days and weeks: what you might feel, and what can wait.' },
  { title: 'Making Treatment Decisions', text: 'Understanding options, asking questions, and second opinions.' },
  { title: 'What to Expect During Treatment', text: 'Surgery, chemotherapy and radiotherapy, and the days in between.' },
  { title: 'Building Mental Strength & Resilience', text: 'Coping with fear and uncertainty, and finding realistic hope.' },
  { title: 'Supporting a Loved One with Cancer', text: 'Practical and emotional help for caregivers, including caring for yourself.' },
  { title: 'Life During and After Cancer', text: 'Work, family, follow-ups, and finding your feet again.' },
];
---
<HubPage title="Guides" eyebrow="Guides" lede="Seven plain-language guides, each summarised from official and medical sources, with every source listed. We're writing them now and will publish each one only when it's checked.">
  <Hub items={guides} />
</HubPage>
