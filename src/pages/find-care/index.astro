---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { url } from '../../lib/url';

const sections = [
  { icon: 'path', title: 'Coming to Delhi for treatment', text: 'What to bring, how to get an appointment, where to stay.', href: '/find-care/coming-to-delhi', ready: true },
  { icon: 'search', title: 'Cancer hospitals in Delhi NCR', text: 'Treatment centres with official contacts and the date we last checked them.', href: '/find-care/hospitals', ready: true },
  { icon: 'check', title: 'Which schemes should we ask about?', text: 'Five quick questions to see which government help may apply. Nothing is saved.', href: '/find-care/help-finder', ready: true },
  { icon: 'bookmark', title: 'Help with treatment costs', text: 'Government schemes, who they are for, and how to apply.', href: '/find-care/financial-help', ready: true },
] as const;
---
<Base title="Find care" description="Practical help finding cancer care in India: hospitals, travel to Delhi, and help with costs.">
  <div class="container page">
    <header class="head stack">
      <p class="eyebrow">Find care</p>
      <h1>Finding care in India</h1>
      <p class="lede">Practical help with hospitals, travel and costs. We're starting with Delhi and the surrounding region.</p>
    </header>
    <ul class="grid" role="list" style="--min: 17rem">
      {sections.map((s) => (
        <li class="card item reveal">
          <span class="icon"><Icon name={s.icon} size={24} /></span>
          <h2>{s.href ? <a href={url(s.href)}>{s.title}</a> : s.title}</h2>
          <p class="small">{s.text}</p>
          {!s.ready && <p class="soon small">Coming soon</p>}
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .page { padding-block: var(--s8) var(--s6); }
  .head { --stack: var(--s4); max-width: 46rem; margin-bottom: var(--s6); }
  ul { list-style: none; padding: 0; }
  .item { position: relative; display: grid; gap: var(--s3); align-content: start; max-width: none; }
  .item:has(a):hover { border-color: var(--primary); }
  .icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--surface-teal); color: var(--primary); }
  h2 { font-size: var(--text-lg); }
  h2 a { color: var(--ink); text-decoration: none; }
  h2 a::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius); }
  .item:has(a:focus-visible) { outline: 3px solid var(--focus); outline-offset: 3px; }
  h2 a:focus-visible { outline: none; }
  p { color: var(--ink-soft); }
  .soon { justify-self: start; font-weight: 700; color: var(--info); background: var(--surface-blue); padding: 2px var(--s3); border-radius: var(--radius-pill); }
</style>
