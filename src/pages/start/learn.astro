---
import StartPath, { type Step } from '../../layouts/StartPath.astro';
const steps: Step[] = [
  {
    title: 'Start with the words',
    body: `<p>Our glossary explains medical and hospital terms in plain language. It grows as we publish more.</p>`,
    links: [{ label: 'Glossary', href: '/glossary' }, { label: 'Understanding cancer: the basics', href: '/guides/understanding-cancer-basics' }],
  },
  {
    title: 'See how we handle evidence',
    body: `<p>Our editorial policy explains which sources we trust, how we label review status, and how we treat statistics.</p>`,
    links: [{ label: 'How we make Hausla', href: '/editorial-policy' }],
  },
  {
    title: 'Understand cancer care in India',
    body: `<p>Our practical guides describe how families actually reach care: registration systems, government schemes and hospitals.</p>`,
    links: [
      { label: 'Help with treatment costs', href: '/find-care/financial-help' },
      { label: 'Cancer hospitals in Delhi NCR', href: '/find-care/hospitals' },
    ],
  },
];
---
<StartPath
  title="If you want to learn or research"
  lede="For students, researchers and the curious: the science of cancer, the data on cancer in India, and where to begin."
  current="/start/learn"
  steps={steps}
  coming={['Cancer in India: statistics with full sources (ICMR-NCRP, GLOBOCAN)', 'A beginner-friendly research library and learning paths', 'Scientific literacy: how to read a research paper']}
/>
